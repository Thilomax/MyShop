@model IEnumerable<MyShop.Models.Item>
<div class="container">
    <h1>@ViewBag.CurrentViewName</h1>
    <table class='table table-striped'>

        <!--This below creates a table row with ID, Name, Price and Description.-->
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Price</th>
            <th>Description</th>
        </tr>
        <!--This is a loop that displays all the items on the home page. it iterates 
            through all the items and puts each objects properties on the page-->
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ItemId</td>
                <td>@item.Name</td>
                <td>@item.Price.ToString("0.00 NOK")</td>
                <td></td>
            </tr>
        }
    </table>
</div>
