@model Item
@*This is the page that comes up when you click the name of the dish. it shows the description, name and image and gives two links*@
<h3 class="my-5">
    @Model.Name
</h3>

<div class="row gx-5">
    <img alt="@Model.Name" src="@Model.ImageUrl" class="img-fluid col-5" />
    <div class="col-7">
        <h5>@Model.Description</h5>
        <h3 class="pull-right">@Model.Price.ToString("0.00 NOK")</h3>
        <p><a href="/Item/Table">Back to Table View</a></p> @*these are links that point to grid and table view*@
        <p><a href="/Item/Grid">Back to Grid View</a></p>
    </div>
</div>