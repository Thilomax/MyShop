@{
    ViewData["Title"] = "Home Page"; //this is the title of the page but in a way so that we dont need all the metadata stuff from html
}

<div class="text-center">
    <h1 class="display-4">Welcome to My Shop</h1> @*Just a random div with a header.*@
</div>

@*Now were gonna add a dynamic carousel that displays three images
it will have left and right arrow control
To make that work, we need to add some client side files and javascript libraries*@
<partial name="_Carousel" />

    <!-- Left and Right Controls -->
    <button class="carousel-control-prev" type="button" data-bs-target="#carouselImages" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#carouselImages" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
    </button>
</div>