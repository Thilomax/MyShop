@{
    ViewData["Title"] = "Home Page"; //this is the title of the page but in a way so that we dont need all the metadata stuff from html
}

<div class="text-center">
    <h1 class="display-4">Welcome to My Shop</h1> @*Just a random div with a header.*@
</div>

@*Now were gonna add a dynamic carousel that displays three images
it will have left and right arrow control
To make that work, we need to add some client side files and javascript libraries*@
<div id="carouselImages" class="carousel slide" data-bs-ride="true">
    <div class="carousel-indicators">
        <button type="button" data-bs-target="#carouselImages" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
        <button type="button" data-bs-target="#carouselImages" data-bs-slide-to="1" aria-label="Slide 2"></button>
        <button type="button" data-bs-target="#carouselImages" data-bs-slide-to="2" aria-label="Slide 3"></button>
    </div>
    <div class="carousel-inner">
        <div class="carousel-item">
            <img src="~/images/pizza.jpg" class="d-block w-100" alt="Pizza">
            <p>Pizza!</p>
        </div>
        <div class="carousel-item active">
            <img src="~/images/fried_chicken.jpg" class="d-block w-100" alt="Fried Chicken Leg">
            <p>Fried chicken leg!</p>
        </div>
        <div class="carousel-item">
            <img src="~/images/suspicious_stew.png" class="d-block w-100" alt="Thilo's Special Stew">
            <p>Thilo's suspicious stew</p>
        </div>
    </div>

    <!-- Left and Right Controls -->
    <button class="carousel-control-prev" type="button" data-bs-target="#carouselImages" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#carouselImages" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
    </button>
</div>